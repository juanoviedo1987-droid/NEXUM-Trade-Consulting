    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0 || !items[0].json || !items[0].json.id) {\n  return [];\n}\n\nreturn items.map(item => {\n  const l = item.json;\n  const telClean = (l.telefono || '').replace(/[^0-9]/g, '');\n  const waLink = telClean ? `https://wa.me/${telClean}` : '#';\n  \n  const html = `🚨 <b>¡NUEVO LEAD EN NEXUM TRADE CONSULTING!</b>\\n\\n` +\n    `👤 <b>Contacto:</b> ${l.nombre}\\n` +\n    `🏢 <b>Empresa:</b> ${l.empresa}\\n` +\n    `📧 <b>Email:</b> ${l.email}\\n` +\n    `📱 <b>WhatsApp:</b> <a href=\"${waLink}\">${l.telefono}</a>\\n` +\n    `🎯 <b>Situación:</b> ${l.operacion}\\n` +\n    `💬 <b>Mensaje:</b> ${l.mensaje || 'Sin detalles'}\\n\\n` +\n    `📅 <i>Registrado el: ${new Date(l.created_at).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' })}</i>`;\n    \n  return {\n    json: {\n      id: l.id,\n      nombre: l.nombre,\n      empresa: l.empresa,\n      email: l.email,\n      mensajeHtml: html\n    }\n  };\n});"
      },
